# ─── Banco de dados (Supabase) ────────────────────────────────────────────────
# URL via pgBouncer/pooler — usada pela aplicação (Vercel serverless)
# Supabase: Project Settings > Database > Connection Pooling > Transaction mode (porta 6543)
DATABASE_URL="postgresql://postgres.[ref]:senha@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta — usada APENAS para prisma migrate (nunca vai para a Vercel)
# Supabase: Project Settings > Database > Connection string (porta 5432)
DIRECT_URL="postgresql://postgres:senha@db.[ref].supabase.co:5432/postgres"

# ─── Shopify ──────────────────────────────────────────────────────────────────
# Shopify Admin > Settings > Notifications > Webhooks > Signing secret
SHOPIFY_WEBHOOK_SECRET=""

# ─── Auth ─────────────────────────────────────────────────────────────────────
# true = pula autenticação real (apenas desenvolvimento)
AUTH_BYPASS_IN_DEV="true"
