# ─── Banco de dados (Supabase) ────────────────────────────────────────────────
# URL via pgBouncer/pooler — usada pela aplicação (Vercel serverless)
# Supabase: Project Settings > Database > Connection Pooling > Transaction mode (porta 6543)
DATABASE_URL="postgresql://postgres.[ref]:senha@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta — usada APENAS para prisma migrate (nunca vai para a Vercel)
# Supabase: Project Settings > Database > Connection string (porta 5432)
DIRECT_URL="postgresql://postgres:senha@db.[ref].supabase.co:5432/postgres"

# ─── Worker Sync OMS -> CORE-FIN (ETAPA 3) ───────────────────────────────────
# Conexao de leitura/controle tecnico no ALP-OMS (integration.sync_events)
OMS_DB_URL="postgresql://postgres:senha@db.[ref-oms].supabase.co:5432/postgres"

# Conexao de escrita no ALP-CORE-FIN (mirror.raw_payloads)
CORE_DB_URL="postgresql://postgres:senha@db.[ref-core-fin].supabase.co:5432/postgres"

# Lote maximo por execucao one-shot
BATCH_SIZE="100"

# Limite de tentativas por evento antes de ir para DLQ
MAX_RETRIES="5"

# Reservado para modo continuo local (MVP em producao usa cron/one-shot)
SYNC_INTERVAL_MS="5000"

# ─── Supabase Auth ────────────────────────────────────────────────────────────
# Supabase: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"

# Supabase: Project Settings > API > Publishable (anon) key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ─── Shopify ──────────────────────────────────────────────────────────────────
# Shopify Admin > Settings > Notifications > Webhooks > Signing secret
SHOPIFY_WEBHOOK_SECRET=""

# ─── Auth ─────────────────────────────────────────────────────────────────────
# true = pula autenticação real (apenas desenvolvimento local)
AUTH_BYPASS_IN_DEV="false"
