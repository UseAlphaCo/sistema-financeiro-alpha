# ============================================================================
# Sistema Financeiro — variaveis de ambiente
# Copie para .env e preencha com valores reais. Nunca comite o .env real.
# ============================================================================

# ─── Banco de dados da aplicacao (Supabase Postgres via Prisma) ───────────────
# URL via pgBouncer/pooler (porta 6543, transaction mode) — usada em runtime
# pela app serverless (Vercel).
# Supabase: Project Settings > Database > Connection Pooling > Transaction mode
DATABASE_URL="postgresql://postgres.[ref]:senha@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL direta (porta 5432) — usada APENAS por `prisma migrate`, nunca em
# runtime da app. Supabase: Project Settings > Database > Connection string
DIRECT_URL="postgresql://postgres:senha@db.[ref].supabase.co:5432/postgres"

# ─── NextAuth (Auth.js v5) — login por credenciais (email/senha via Prisma) ───
# Segredo usado para assinar JWT/sessao. Gere com `openssl rand -base64 32`.
NEXTAUTH_SECRET="troque-por-um-valor-forte"

# URL publica da app (usada por NextAuth para callbacks). Em producao deve
# ser a URL real do dominio (ex: Vercel). Em dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# true = pula autenticacao real (SOMENTE desenvolvimento local, nunca em prod)
AUTH_BYPASS_IN_DEV="false"

# ─── Shopify ───────────────────────────────────────────────────────────────
# Shopify Admin > Settings > Notifications > Webhooks > Signing secret
SHOPIFY_WEBHOOK_SECRET=""

# Dominio da loja Shopify (ex: minha-loja.myshopify.com)
SHOPIFY_STORE_URL=""

# Admin API access token da app privada/custom app do Shopify. Usado pelo
# job de resolucao de gateway titular (shopify-payment-resolution-job.ts) e
# pelo script scripts/verify-shopify-values.ts.
SHOPIFY_ACCESS_TOKEN=""

# true = desativa o endpoint de webhook Shopify (retorna 410). Ja e forcado
# automaticamente quando o mirror (abaixo) esta ativo; declare explicito se
# quiser desativar o webhook mesmo sem o mirror ligado.
DISABLE_SHOPIFY_WEBHOOKS="true"

# ─── Worker Sync OMS -> CORE-FIN (ETAPA 3) ────────────────────────────────────
# Conexao de LEITURA no projeto Supabase do OMS (ALP-OMS), usada so pelo
# worker de sync para ler public.raw_payloads. OMS e read-only.
OMS_DB_URL="postgresql://postgres:senha@db.[ref-oms].supabase.co:5432/postgres"

# Conexao de ESCRITA no projeto Supabase deste app (ALP-CORE-FIN), para o
# mirror.raw_payloads e todo o controle tecnico de sync (integration.sync_queue,
# integration.failed_jobs, advisory lock). Conexao DIRETA (porta 5432), nao o
# pooler — o worker de sync precisa de transacoes/locks que o pooler em modo
# transaction nao suporta bem. Se ausente, algumas leituras do read model caem
# de volta para DATABASE_URL (ver src/shared/read-model-config.ts) — prefira
# sempre configurar explicitamente em vez de depender do fallback.
CORE_DB_URL="postgresql://postgres:senha@db.[ref-core-fin].supabase.co:5432/postgres"

# Alvo do controle tecnico de sync: "core" (padrao) mantem o OMS read-only.
# "oms" e apenas fallback de emergencia para rollback controlado.
SYNC_CONTROL_TARGET="core"

# Retencao da DLQ (integration.failed_jobs) no CORE, em dias.
DLQ_RETENTION_DAYS="90"

# Lote maximo por execucao one-shot do worker.
BATCH_SIZE="100"

# Limite de tentativas por evento antes de ir para a DLQ.
MAX_RETRIES="5"

# Chave tecnica para autenticar chamadas do scheduler externo (Cloudflare
# Worker em cloudflare/worker-sync-cron). DEVE ser identico ao secret
# `CRON_SECRET` configurado via `wrangler secret put` no worker Cloudflare.
# Tambem autentica /api/internal/cron/shopify-payment-resolution.
CRON_SECRET="troque-por-um-valor-forte"

# Escopo retroativo padrao do job de sync automatico (30, 60 ou 90 dias),
# usado so quando a chamada nao informa ?days= explicitamente. Deve
# conceitualmente bater com WORKER_CRON_DAYS em
# cloudflare/worker-sync-cron/wrangler.jsonc, mas nao ha sincronizacao
# automatica entre os dois — atualize manualmente nos dois lugares.
WORKER_CRON_DAYS="30"

# ─── Read model (mirror-first) ────────────────────────────────────────────────
# true = le fluxo de caixa/transacoes via mirror.raw_payloads (CORE) em vez
# da tabela legada FinancialTransaction. Fica ligado automaticamente sempre
# que houver uma CORE_DB_URL (ou DATABASE_URL) valida, a menos que esta flag
# seja explicitamente "false". Deve ficar "true" em qualquer ambiente com
# CORE_DB_URL configurado, inclusive local/dev.
FINANCIAL_READ_MODEL_MIRROR="true"

# ============================================================================
# NAO usadas pelo codigo atual — mantidas aqui so como referencia historica.
# Remover quando confirmado que nao ha plano de reintroduzir Supabase Auth
# client-side nem o modo continuo local do worker.
# ============================================================================
# NEXT_PUBLIC_SUPABASE_URL=""             # orfa: sem @supabase/supabase-js no projeto (auth e via NextAuth)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""  # orfa: idem
# SYNC_INTERVAL_MS="5000"                  # orfa: reservado p/ modo continuo local (nao implementado, app roda em cron/one-shot)
