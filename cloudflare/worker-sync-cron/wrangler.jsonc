{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-financeiro-worker-sync-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-09",
  "triggers": {
    // ATENCAO: o array e a fonte de verdade no deploy. Remover a chave
    // "triggers" NAO apaga os cron triggers ja registrados no Cloudflare;
    // so o array explicito os substitui.
    //
    // ATENCAO 2: as expressoes tambem sao a chave do switch em src/index.ts.
    // Mudar aqui sem mudar la faz o cron cair no `default` e so lancar erro.
    //
    // ATENCAO 3: /api/internal esta em FROZEN_API_PREFIXES (src/proxy.ts), entao
    // estes crons so fazem trabalho util com o freeze desligado. Desde 25/08/2026
    // o default de MAINTENANCE_MODE e "desligado", entao basta a Vercel estar no
    // ar com esse codigo; se a env var MAINTENANCE_MODE="true" ainda existir la,
    // todo cron aqui coleciona 503 ate ela sair.
    // ATENCAO 4: esta cadencia e orcamento de CPU, nao preferencia. Em 25/08/2026
    // a conta bateu 100% das 4 horas de Fluid Active CPU do plano gratuito no
    // PRIMEIRO dia com os crons religados. O sync a cada 15 min era o dominante:
    // 96 invocacoes/dia rodando ate os 60 s inteiros, cada uma fazendo round-trip
    // de JSON de 56 a 240 MB. Aumentar a frequencia aqui sem antes parar de
    // trafegar payload_json inteiro (ver mirror-events-repository.ts) volta a
    // estourar a cota.
    "crons": [
      // Sync OMS->mirror por cursor fisico de pagina (cauda + auditoria).
      // A cada 3 horas: e o atraso maximo acordado entre a venda acontecer no
      // OMS e aparecer no sistema, e ainda entrega o dia fechado a tempo da
      // materializacao das 23h. Uma volta de auditoria passa a levar ~28 h, e a
      // regra das duas voltas pede ~56 h antes de declarar completude.
      "0 */3 * * *",
      // Resolucao de gateway titular Shopify, escopada aos ultimos dias.
      // CPU baixa (espera de rede), mas cada rodada segura a funcao por ~75 s
      // por causa do portao de ritmo do bucket da Shopify.
      "0 */2 * * *",
      // Verificacao Sistema x Shopify, 1x/dia as 06:00 BRT, sempre sobre D-1
      // (dia maduro). Era horaria; cada execucao busca transacoes de ~1.700
      // pedidos e forca o Postgres a detoastar payload_json da janela inteira.
      "0 9 * * *",
      // Materializacao, um dia por invocacao (D-0, D-1, D-2). 02:00 UTC =
      // 23:00 BRT, com D-0 ja praticamente fechado.
      //
      // ATENCAO 5: D-1 saiu das 23:15 para 09:30 UTC = 06:30 BRT. As 23 h o
      // mirror ainda nao tem as ultimas horas do dia (sync de 3 em 3 h), entao
      // o passe D-0 fecha o dia em ~78%; com D-1 na mesma noite, a correcao so
      // chegava 24 h depois -- durante todo o dia em que aquela data e "Ontem"
      // na tela. Ver o docblock de MATERIALIZE_CRONS em src/index.ts.
      // Nao colide com "0 9 * * *" (shopify-verify, 06:00 BRT).
      //
      // ATENCAO 6: D-1 roda DUAS vezes, 06:30 e 11:05 BRT (14:05 UTC). As 06:30
      // ainda perde os `orders/paid` atrasados -- em 30/08/2026 foram 6 pedidos,
      // R$ 778,25, com paid chegando de 47 a 63 min depois do passe. 11:05 BRT e
      // quando os relatorios da Shopify fecham a contagem de "ontem". Custa +1
      // invocacao/dia da rota de materializacao (~45-70 s de wall time, quase
      // toda em espera de banco). Ver o docblock de MATERIALIZE_CRONS.
      "0 2 * * *",
      "30 9 * * *",
      "5 14 * * *",
      "30 2 * * *"
    ]
  },
  "vars": {
    "APP_BASE_URL": "https://phi.usealphaco.com.br",
    "WORKER_CRON_DAYS": "30",
    "SHOPIFY_RESOLUTION_BATCH_SIZE": "150",
    "SHOPIFY_RESOLUTION_SINCE_DAYS": "3"
  }
}
